//@version=6
indicator("Swing Breakout SFP Signal", shorttitle = "Swing SFP", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// Pine Script translation of the cTrader SwingBreakoutSFPSignal indicator.
// Signals are confirmed at bar close. Pivot-dependent features appear only
// after their configured right-side confirmation bars have completed.
//
// A confirmed MAJOR swing pivot is the only trigger - no level reaction,
// break, or retest step. A fresh A-B-C-D-E attempt starts directly from any
// confirmed Major swing low (bullish) or swing high (bearish). Pivot
// detection (ta.pivothigh/pivotlow) is a pure shape test over a fixed
// bar-count window with no price/ATR distance involved, which is what
// makes it find small and large swings identically. A uses the bigger
// Major lookback rather than the minor one used for B/C/D and Confidence
// Dots - a small lookback fires on noise-sized wiggles, which would spawn
// a fresh conflicting setup on almost every ranging stretch.

groupSignal = "Signal"
groupConfidence = "Confidence Dots"

swingLeft = input.int(5, "Swing Lookback - Left Bars", minval = 1, maxval = 50, group = groupSignal)
swingRight = input.int(5, "Swing Lookback - Right Bars", minval = 1, maxval = 50, group = groupSignal)
atrPeriod = input.int(5, "ATR Period", minval = 1, group = groupSignal)
stopMode = input.string("Normal", "Stop-Loss Mode", options = ["Conservative", "Normal"], group = groupSignal)
showAbcdStructure = input.bool(true, "Show A-B-C-D Structure", group = groupSignal)
maxBarsFromExtensionBreakToD = input.int(80, "Max. Bars from 100% Break to D", minval = 1, maxval = 100, group = groupSignal)

showConfidenceDots = input.bool(true, "Show Confidence Dots", group = groupConfidence)
majorLeft = input.int(15, "Major Swing Lookback - Left Bars", minval = 1, maxval = 100, group = groupConfidence)
majorRight = input.int(15, "Major Swing Lookback - Right Bars", minval = 1, maxval = 100, group = groupConfidence)
maxConfidenceDots = input.int(80, "Max Visible Confidence Dots (per tier)", minval = 10, maxval = 400, group = groupConfidence, tooltip = "Older dots beyond this count are deleted. Keeps the chart's price scale fitted to recent price action and keeps TradingView's renderer from lagging behind on pan/zoom.")
confidenceDotSize = input.int(4, "Confidence Dot Size", minval = 1, maxval = 20, group = groupConfidence)

f_window_buy_pct(length) =>
    float buyVolume = 0.0
    float sellVolume = 0.0
    for i = 0 to length
        if close[i] > open[i]
            buyVolume += volume[i]
        else if close[i] < open[i]
            sellVolume += volume[i]
        else
            buyVolume += volume[i] / 2
            sellVolume += volume[i] / 2
    float total = buyVolume + sellVolume
    total > 0 ? buyVolume / total * 100 : 50

atr = ta.atr(atrPeriod)

pivotHigh = ta.pivothigh(high, swingLeft, swingRight)
pivotLow = ta.pivotlow(low, swingLeft, swingRight)
majorHigh = ta.pivothigh(high, majorLeft, majorRight)
majorLow = ta.pivotlow(low, majorLeft, majorRight)

// A-B-C-D state machine: 0 idle, 1 seeking B, 2 seeking C, 3 seeking extension, 4 seeking D.
var int bullState = 0
var int bearState = 0
var int bullPhaseStart = na
var int bearPhaseStart = na
var float bullA = na
var float bullB = na
var float bullC = na
var float bullD = na
var float bearA = na
var float bearB = na
var float bearC = na
var float bearD = na
var int bullABar = na
var int bullBBar = na
var int bullCBar = na
var int bullDBar = na
var int bearABar = na
var int bearBBar = na
var int bearCBar = na
var int bearDBar = na
bool bullishSignal = false
bool bearishSignal = false
float stopAnchor = na
float targetLevel = na
float entryLevel = na

f_draw_abcd_expansion(aBar, a, bBar, b, cBar, c, dBar, d, signalBar, isBullish, color) =>
    if aBar < bBar and bBar < cBar and cBar < dBar
        line.new(aBar, a, bBar, b, color = color, width = 1)
        line.new(bBar, b, cBar, c, color = color, width = 1)
        label.new(aBar, a, "A", style = isBullish ? label.style_label_up : label.style_label_down, color = color, textcolor = color.white)
        label.new(bBar, b, "B", style = isBullish ? label.style_label_down : label.style_label_up, color = color, textcolor = color.white)
        label.new(cBar, c, "C", style = isBullish ? label.style_label_up : label.style_label_down, color = color, textcolor = color.white)
        float leg = b - a
        for ratio in array.from(0.0, 0.5, 1.0, 1.618, 2.0, 2.618, 3.618)
            float level = c + leg * ratio
            string levelText = str.tostring(ratio * 100, "#.###") + "%"
            line.new(cBar, level, signalBar, level, color = color, style = line.style_dotted)
            label.new(signalBar, level, levelText, style = label.style_none, textcolor = color)
        label.new(dBar, d, "D", style = isBullish ? label.style_label_down : label.style_label_up, color = color, textcolor = color.white)
        float entry = (d + c) / 2
        line.new(dBar, entry, signalBar, entry, color = color, width = 2)
        label.new(signalBar, entry, "E (50% entry)", style = label.style_none, textcolor = color)

if not na(majorLow)
    bullState := 1
    bullPhaseStart := bar_index - majorRight
    bullA := majorLow
    bullB := na
    bullC := na
    bullD := na
    bullABar := bar_index - majorRight
    bullBBar := na
    bullCBar := na
    bullDBar := na
else if bullState != 0
    if close < bullA
        bullState := 0
        bullABar := na
        bullBBar := na
        bullCBar := na
        bullDBar := na
    else if bullState == 1
        if not na(pivotHigh) and bar_index - swingRight > bullPhaseStart and pivotHigh > bullA
            bullB := pivotHigh
            bullBBar := bar_index - swingRight
            bullState := 2
            bullPhaseStart := bar_index - swingRight
    else if bullState == 2
        if not na(pivotLow) and bar_index - swingRight > bullPhaseStart and pivotLow < bullB and pivotLow > bullA and pivotLow <= (bullA + bullB) / 2
            bullC := pivotLow
            bullCBar := bar_index - swingRight
            bullState := 3
            bullPhaseStart := bar_index - swingRight
    else if bullState == 3 and close > bullC + (bullB - bullA)
        bullState := 4
        bullPhaseStart := bar_index
        bullD := high
        bullDBar := bar_index
    else if bullState == 4
        if bar_index - swingRight - bullPhaseStart > maxBarsFromExtensionBreakToD
            bullState := 0
        else
            if high > bullD
                bullD := high
                bullDBar := bar_index
            if not na(pivotLow) and bar_index - swingRight > bullPhaseStart
                entryLevel := (bullD + bullC) / 2
                if bullABar < bullBBar and bullBBar < bullCBar and bullCBar < bullDBar
                    bullishSignal := true
                    stopAnchor := stopMode == "Conservative" ? bullC : bullA
                    targetLevel := bullC + (bullB - bullA) * 2.618
                    if showAbcdStructure
                        f_draw_abcd_expansion(bullABar, bullA, bullBBar, bullB, bullCBar, bullC, bullDBar, bullD, bar_index, true, color.lime)
                bullState := 0

if not na(majorHigh)
    bearState := 1
    bearPhaseStart := bar_index - majorRight
    bearA := majorHigh
    bearB := na
    bearC := na
    bearD := na
    bearABar := bar_index - majorRight
    bearBBar := na
    bearCBar := na
    bearDBar := na
else if bearState != 0
    if close > bearA
        bearState := 0
        bearABar := na
        bearBBar := na
        bearCBar := na
        bearDBar := na
    else if bearState == 1
        if not na(pivotLow) and bar_index - swingRight > bearPhaseStart and pivotLow < bearA
            bearB := pivotLow
            bearBBar := bar_index - swingRight
            bearState := 2
            bearPhaseStart := bar_index - swingRight
    else if bearState == 2
        if not na(pivotHigh) and bar_index - swingRight > bearPhaseStart and pivotHigh > bearB and pivotHigh < bearA and pivotHigh >= (bearA + bearB) / 2
            bearC := pivotHigh
            bearCBar := bar_index - swingRight
            bearState := 3
            bearPhaseStart := bar_index - swingRight
    else if bearState == 3 and close < bearC + (bearB - bearA)
        bearState := 4
        bearPhaseStart := bar_index
        bearD := low
        bearDBar := bar_index
    else if bearState == 4
        if bar_index - swingRight - bearPhaseStart > maxBarsFromExtensionBreakToD
            bearState := 0
        else
            if low < bearD
                bearD := low
                bearDBar := bar_index
            if not na(pivotHigh) and bar_index - swingRight > bearPhaseStart
                entryLevel := (bearD + bearC) / 2
                if bearABar < bearBBar and bearBBar < bearCBar and bearCBar < bearDBar
                    bearishSignal := true
                    stopAnchor := stopMode == "Conservative" ? bearC : bearA
                    targetLevel := bearC + (bearB - bearA) * 2.618
                    if showAbcdStructure
                        f_draw_abcd_expansion(bearABar, bearA, bearBBar, bearB, bearCBar, bearC, bearDBar, bearD, bar_index, false, color.red)
                bearState := 0

plotshape(bullishSignal, "Bullish A-B-C-D-E Entry", shape.circle, location.belowbar, color.lime, size = size.small, text = "BUY")
plotshape(bearishSignal, "Bearish A-B-C-D-E Entry", shape.circle, location.abovebar, color.red, size = size.small, text = "SELL")
plot(stopAnchor, "Stop Anchor", color = color.new(color.red, 0), style = plot.style_cross, linewidth = 2)
plot(targetLevel, "Target Level", color = color.new(color.aqua, 0), style = plot.style_cross, linewidth = 2)
plot(entryLevel, "Entry Level", color = color.new(color.yellow, 0), style = plot.style_cross, linewidth = 2)

// Confidence dots use chart-bar volume direction. TradingView volume has no
// true bid/ask split, so this is the closest portable equivalent to cTrader's
// lower-timeframe tick-volume classification.
minorHigh = pivotHigh
minorLow = pivotLow
var array<label> majorDotLabels = array.new<label>()
var array<label> minorDotLabels = array.new<label>()
var int lastMajorCode = na
var int lastMinorCode = na
// f_window_buy_pct loops over its window (O(majorRight)/O(swingRight) per
// call) - only worth paying for on the rare bar a pivot actually confirms,
// not every bar. Pine's ?: only evaluates the taken branch (unlike and/or,
// which are eager), so this genuinely skips the loop otherwise.
majorBuyPct = (not na(majorHigh) or not na(majorLow)) ? f_window_buy_pct(majorRight) : na
minorBuyPct = (not na(minorHigh) or not na(minorLow)) ? f_window_buy_pct(swingRight) : na
majorCode = na(majorBuyPct) ? 0 : (majorBuyPct >= 70 ? 1 : majorBuyPct <= 30 ? -1 : 0)
minorCode = na(minorBuyPct) ? 0 : (minorBuyPct >= 70 ? 1 : minorBuyPct <= 30 ? -1 : 0)
majorTransparency = na(majorBuyPct) ? 100 : int(math.round(80 - math.min(math.abs(majorBuyPct - 50.0) / 50.0, 1.0) * 80))
minorTransparency = na(minorBuyPct) ? 100 : int(math.round(80 - math.min(math.abs(minorBuyPct - 50.0) / 50.0, 1.0) * 80))
majorChanged = na(lastMajorCode) or majorCode != lastMajorCode
minorChanged = na(lastMinorCode) or minorCode != lastMinorCode
majorDot = showConfidenceDots and (not na(majorHigh) or not na(majorLow)) and majorChanged
minorDot = showConfidenceDots and (not na(minorHigh) or not na(minorLow)) and minorChanged
majorDotColor = majorCode == 1 ? color.new(color.lime, majorTransparency) : majorCode == -1 ? color.new(color.red, majorTransparency) : color.new(color.rgb(255, 179, 0), majorTransparency)
minorDotColor = minorCode == 1 ? color.new(color.lime, minorTransparency) : minorCode == -1 ? color.new(color.red, minorTransparency) : color.new(color.rgb(255, 179, 0), minorTransparency)

// Labels (not plotshape) so confidence can be shown as a hover tooltip,
// matching the cTrader ChartIcon.Comment tooltip.
if majorDot
    lastMajorCode := majorCode
    majorY = not na(majorHigh) ? high[majorRight] + atr[majorRight] * 0.5 : low[majorRight] - atr[majorRight] * 0.5
    majorDotLabels.push(label.new(time[majorRight], majorY, "", xloc = xloc.bar_time, style = label.style_diamond, size = confidenceDotSize, color = majorDotColor, tooltip = "Confidence: " + str.tostring(math.round(majorBuyPct)) + "%"))
    if majorDotLabels.size() > maxConfidenceDots
        label.delete(majorDotLabels.shift())
if minorDot
    lastMinorCode := minorCode
    minorY = not na(minorHigh) ? high[swingRight] + atr[swingRight] * 0.5 : low[swingRight] - atr[swingRight] * 0.5
    minorDotLabels.push(label.new(time[swingRight], minorY, "", xloc = xloc.bar_time, style = label.style_circle, size = confidenceDotSize, color = minorDotColor, tooltip = "Confidence: " + str.tostring(math.round(minorBuyPct)) + "%"))
    if minorDotLabels.size() > maxConfidenceDots
        label.delete(minorDotLabels.shift())

alertcondition(bullishSignal, "Bullish A-B-C-D-E Entry", "Bullish A-B-C-D-E entry on {{ticker}}")
alertcondition(bearishSignal, "Bearish A-B-C-D-E Entry", "Bearish A-B-C-D-E entry on {{ticker}}")
alertcondition((majorDot and majorCode == 1) or (minorDot and minorCode == 1), "Green Confidence Dot", "Green confidence dot on {{ticker}}")
alertcondition((majorDot and majorCode == -1) or (minorDot and minorCode == -1), "Red Confidence Dot", "Red confidence dot on {{ticker}}")
